+// ── MEMO (메모 📝 표시 — memo-indicator) ──
+// 서랍 이름: 에어비앤비 <호실>|<입실일> / 부킹·트립·리브·블락은 꼬리표 _bk _tr _lv _bl (청소앱과 같다)
+// 메모 목록 memo_index: 메모가 있는 서랍만 한 줄 [{key,room,ch,cin,cout,uid?}]. 달력 📝 는 이것만 본다
+// ⛔ 날짜 이동·30일 정리 판정은 워커(upkeepMemos) 한 곳에만. 앱은 쓰고 지울 때 줄만 넣고 뺀다 (#2)
+let memoIndex = [];
+let _memoRanges = null;   // render 마다 다시 만든다
+const MEMO_CH   = {airbnb:'ab','ab-block':'ab',booking:'bk',trip:'tr',lv:'lv',block:'bl'};
+const MEMO_SFX  = {ab:'',bk:'_bk',tr:'_tr',lv:'_lv',bl:'_bl'};
+const MEMO_ICON = {ab:'✈',bk:'🏨',tr:'🌐',lv:'🏡',bl:'🔒'};
+const ymd8 = (y,m,d) => `${y}${String(m+1).padStart(2,'0')}${String(d).padStart(2,'0')}`;
+function drawerKey(roomName,e){ return `${roomName}|${ymd8(e.cinY,e.cinM,e.cinD)}${MEMO_SFX[MEMO_CH[e.platform]]}`; }
+// 머리표 "🏨 10/20~10/28" — 메모를 쓴 순간의 예약으로 고정 (옛 메모는 지금 예약으로 대신한다)
+function memoHead(memo,e){
+  const ch=memo.ch||MEMO_CH[e.platform];
+  const cin=memo.cin||ymd8(e.cinY,e.cinM,e.cinD);
+  const cout=memo.ch?(memo.cout||''):ymd8(e.coutY,e.coutM,e.coutD);
+  const md=s=>s?`${+s.slice(4,6)}/${+s.slice(6,8)}`:'';
+  return `${MEMO_ICON[ch]||''} ${md(cin)}~${md(cout)}`;
+}
+async function loadMemoIndex(){
+  try{
+    const resp=await fetch(`${PROXY}/extra?key=memo_index`);
+    if(resp.ok){
+      const d=await resp.json();
+      if(Array.isArray(d)){ memoIndex=d; try{localStorage.setItem('hana_memo_index',JSON.stringify(d));}catch(e){} return; }
+      if(d&&Array.isArray(d.memos)&&!d.memos.length){ memoIndex=[]; return; }   // 아직 목록이 없다
+    }
+  }catch(e){}
+  try{ const d=JSON.parse(localStorage.getItem('hana_memo_index')||'null'); if(Array.isArray(d)) memoIndex=d; }catch(e){}
+}
+// 메모를 쓰거나 지운 뒤 — 그 서랍에 메모가 남았는지로 목록 한 줄을 넣고 뺀다
+async function syncMemoIndex(key,e,roomName){
+  const ch=MEMO_CH[e.platform]; if(!ch) return;
+  const has=(getExtra(key).memos||[]).length>0;
+  const row={key,room:roomName,ch,cin:ymd8(e.cinY,e.cinM,e.cinD),cout:ymd8(e.coutY,e.coutM,e.coutD),...(e.uid?{uid:e.uid}:{})};
+  const res=await saveListMerged('memo_index','hana_memo_index',list=>{
+    const out=list.filter(x=>x.key!==key); if(has) out.push(row); return out;
+  },true);
+  if(res){ memoIndex=res; render(); attachCellClicks(); }
+}
+// 목록 한 줄 → 지금 화면의 예약 기간. 예약이 사라졌으면 null (📝 안 뜸, 메모는 그대로)
+function memoRangesFor(room){
+  if(!_memoRanges) _memoRanges={};
+  if(_memoRanges[room.name]) return _memoRanges[room.name];
+  const out=[];
+  for(const row of memoIndex){
+    if(row.room!==room.name) continue;
+    if(row.ch==='bl'){
+      const b=manualBlocks.find(b=>b.roomName===room.name&&ymd8(b.startY,b.startM,b.startD)===row.cin);
+      if(b) out.push({a:+row.cin,z:+ymd8(b.endY,b.endM,b.endD),blk:true});
+      continue;
+    }
+    const arr={ab:[...(room.bookings||[]),...(room.abBlocks||[])],bk:room.bkBookings,tr:room.trBookings,lv:room.lvBookings}[row.ch]||[];
+    let b=row.uid?arr.find(x=>x.uid===row.uid):null;
+    if(!b) b=arr.find(x=>ymd8(x.cinY,x.cinM,x.cinD)===row.cin);
+    if(b) out.push({a:+ymd8(b.cinY,b.cinM,b.cinD),z:+ymd8(b.coutY,b.coutM,b.coutD),blk:false});
+  }
+  return _memoRanges[room.name]=out;
+}
+// 그 칸에 붙일 📝 위치들: 'r' 오른쪽 위 / 'c' 가운데 위(반반 칸의 나가는 손님 쪽)
+function memoBadges(room,d,y,m){
+  if(!memoIndex.length) return [];
+  const cur=dnum({y,m,d});
+  let whole=false,out=false,inn=false;
+  for(const g of memoRangesFor(room)){
+    if(cur<g.a||cur>g.z) continue;
+    if(g.blk){ if(cur===g.a) inn=true; else whole=true; continue; }
+    if(cur===g.z) out=true; else if(cur===g.a) inn=true; else whole=true;
+  }
+  if(whole||(inn&&!out)) return ['r'];
+  if(!out) return [];
+  // 나가는 손님 메모 — 그날 들어오는 쪽이 있으면(반반 칸) 가운데 위, 아니면 오른쪽 위
+  const isIn=b=>ymd8(b.cinY,b.cinM,b.cinD)===String(cur);
+  const dayHasIn=[room.bookings,room.abBlocks,room.bkBookings,room.trBookings,room.lvBookings].some(a=>(a||[]).some(isIn))
+    ||manualBlocks.some(b=>b.roomName===room.name&&ymd8(b.startY,b.startM,b.startD)===String(cur));
+  if(!dayHasIn) return ['r'];
+  return inn?['c','r']:['c'];
+}
